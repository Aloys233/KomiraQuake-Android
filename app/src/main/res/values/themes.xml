<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KomiraQuake" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F1F3F3</item>
        <item name="android:windowSplashScreenBackground">#F1F3F3</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">#006B62</item>
    </style>
    <!-- Same neutral launch surface as Compose; never flash a red/dark warning window. -->
    <style name="Theme.KomiraQuake.Warning" parent="Theme.KomiraQuake" />
</resources>
